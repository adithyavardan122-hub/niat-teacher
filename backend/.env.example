# ─────────────────────────────────────────────────
# NIAT Teachers – Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────

PORT=5000
NODE_ENV=production

# Your Vercel frontend URL — used for CORS origin whitelist
# Example: https://niat-teachers.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# ElevenLabs API key (server-side — never expose to the client)
ELEVENLABS_API_KEY=
