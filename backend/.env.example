# ─────────────────────────────────────────────────
# NIAT Teachers – Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────

PORT=5000
NODE_ENV=production

# Your Vercel frontend URL — used for CORS origin whitelist
# Example: https://niat-teachers.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# ElevenLabs API key (server-side — never expose to the client)
ELEVENLABS_API_KEY=

# MongoDB Database URI (Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/niat_db
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/niat_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/niat_db

