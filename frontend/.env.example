# ─────────────────────────────────────────────────
# NIAT Teachers – Frontend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────

# Render backend URL — set this in Vercel project settings for production.
# Example: https://niat-teachers-backend.onrender.com
VITE_API_BASE_URL=

# ElevenLabs Configuration
VITE_ELEVENLABS_API_KEY=
VITE_ELEVENLABS_AGENT_ID=
VITE_ELEVENLABS_VOICE_ID_PROGRAMMING=
VITE_ELEVENLABS_VOICE_ID_WEBDEV=
VITE_ELEVENLABS_VOICE_ID_GENAI=
VITE_ELEVENLABS_VOICE_ID_MATHEMATICS=
VITE_ELEVENLABS_VOICE_ID_APTITUDE=
VITE_ELEVENLABS_VOICE_ID_ENGLISH=
VITE_ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Optional LLM keys — the app falls back to free Pollinations if all are blank
VITE_GEMINI_API_KEY=
VITE_GROQ_API_KEY=
VITE_OPENAI_API_KEY=
